# Copy this file to `.env` and fill in real values after creating each free-tier
# account. `.env` is git-ignored — never commit real credentials or connection URIs.

# --- CognoDB Cloud (given in the assignment) ---------------------------------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free --------------------------------------------------------
# Newer Aura Free instances generate a per-instance username (matching the
# instance id) instead of the historical fixed "neo4j" - check your
# downloaded credentials file for the exact value, don't assume either way.
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# --- Memgraph Cloud (free tier) -----------------------------------------------
MEMGRAPH_URI=bolt+s://<instance-id>.memgraph.cloud:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# --- ArangoDB Oasis (free trial) ----------------------------------------------
ARANGO_URI=https://<instance-id>.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DATABASE=benchmark

# --- TigerGraph Cloud (free tier) ---------------------------------------------
# Savanna workspaces use a per-workspace hostname (tg-<workspace-id>.tg-<tenant-id>.i.tgcloud.io)
# not shown anywhere in the console UI - found via the browser's Network tab while
# Query Editor was active. Auth is a "Secret" generated in Admin Portal > Management >
# Users > Secrets, passed as a header - no username/password/token-exchange needed.
TIGERGRAPH_HOST=https://tg-<workspace-id>.tg-<tenant-id>.i.tgcloud.io
TIGERGRAPH_SECRET=
TIGERGRAPH_GRAPH=benchmark

# --- Benchmark run parameters --------------------------------------------------
DATASET_PATH=data/musae_facebook_edges.csv
BENCHMARK_BATCH_SIZE=1000
BENCHMARK_READ_ITERATIONS=100
BENCHMARK_MIXED_CONCURRENCY_LEVELS=1,10,40
BENCHMARK_MIXED_DURATION_SECONDS=30
BENCHMARK_MIXED_READ_RATIO=0.8
